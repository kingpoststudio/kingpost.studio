---
import Base from '../layouts/Base.astro';
---

<Base title="Contact" description="Let’s talk about a project. stu@kingpoststudio.com">
  <section class="stack">
    <div class="page-head">
      <h1>Contact</h1>
      <p class="hud-label">CONTACT</p>
    </div>
    <p class="deck">Let’s talk about a project.</p>
    <ul class="contact-list hud-box">
      <li>
        <span class="label">Email</span>
        <a href="mailto:stu@kingpoststudio.com">stu@kingpoststudio.com</a>
      </li>
      <li>
        <span class="label">GitHub</span>
        <a href="https://github.com/kingpoststudio" rel="noreferrer">github.com/kingpoststudio</a>
      </li>
      <li>
        <span class="label">LinkedIn</span>
        <a href="https://www.linkedin.com/in/kingpoststudio" rel="noreferrer">
          linkedin.com/in/kingpoststudio
        </a>
      </li>
    </ul>
  </section>
</Base>

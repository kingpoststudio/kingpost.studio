---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import { services } from '../data/services.ts';
---

<Base
  title="Home"
  description="King Post Studio. Bespoke web solutions. Design, development, integrations, and normalization."
>
  <section class="home">
    <Mark class="mark--spine" />
    <div class="home__copy stack">
      <h1>King Post Studio</h1>
      <p class="headline">Bespoke Web Solutions</p>
      <p class="deck">
        Design, development, integrations, and normalization. SMB and enterprise. Internal systems
        and market-facing sites.
      </p>
      <section class="home__services" aria-labelledby="services-heading">
        <h2 id="services-heading">Services</h2>
        <ul class="work-list">
          {
            services.map((item) => (
              <li>
                <div class="work-list__name">{item.name}</div>
                <div class="work-list__notes">{item.description}</div>
              </li>
            ))
          }
        </ul>
      </section>
      <div class="cta-row">
        <a class="cta" href="/contact">Talk about a project</a>
        <a class="link-quiet" href="/work">Work</a>
      </div>
    </div>
  </section>
</Base>
